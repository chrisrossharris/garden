---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import { requireAppUser } from '@/lib/auth';
import { listSpaces } from '@/lib/services/spaces';
import { getSubscription } from '@/lib/services/users';
import { flagsFromPlan } from '@/lib/services/feature-gates';
import { completeTask, getDashboardTaskSummary, getWeeklyDigestData, reopenTask } from '@/lib/services/tasks';
import { one } from '@/lib/db/client';

const appUser = await requireAppUser(Astro.locals);
if (!appUser) return Astro.redirect('/');

const doneTaskId = Astro.url.searchParams.get('doneTask');
const doneSpaceId = Astro.url.searchParams.get('doneSpace');
const doneAt = Astro.url.searchParams.get('doneAt');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'digest-complete') {
    const taskId = String(form.get('taskId') ?? '');
    const spaceId = String(form.get('spaceId') ?? '');
    const owned = await one<{ id: string }>(
      `SELECT t.id
       FROM tasks t
       JOIN garden_spaces gs ON gs.id = t.garden_space_id
       LEFT JOIN space_members sm ON sm.garden_space_id = gs.id AND sm.user_id = $3
       WHERE t.id = $1
         AND gs.id = $2
         AND (gs.user_id = $3 OR sm.role::text IN ('OWNER','EDITOR'))`,
      [taskId, spaceId, appUser.id]
    );
    if (owned) {
      await completeTask(taskId, spaceId);
    }
    return Astro.redirect(`/app?doneTask=${encodeURIComponent(taskId)}&doneSpace=${encodeURIComponent(spaceId)}&doneAt=${Date.now()}`);
  }
  if (action === 'digest-undo') {
    const taskId = String(form.get('taskId') ?? '');
    const spaceId = String(form.get('spaceId') ?? '');
    const owned = await one<{ id: string }>(
      `SELECT t.id
       FROM tasks t
       JOIN garden_spaces gs ON gs.id = t.garden_space_id
       LEFT JOIN space_members sm ON sm.garden_space_id = gs.id AND sm.user_id = $3
       WHERE t.id = $1
         AND gs.id = $2
         AND (gs.user_id = $3 OR sm.role::text IN ('OWNER','EDITOR'))`,
      [taskId, spaceId, appUser.id]
    );
    if (owned) {
      await reopenTask(taskId, spaceId);
    }
    return Astro.redirect('/app');
  }
}

const spaces = await listSpaces(appUser.id);
const sub = await getSubscription(appUser.id);
const flags = flagsFromPlan((sub?.plan as 'BASIC' | 'PLUS' | 'ULTRA' | null) ?? null);
const taskSummary = await getDashboardTaskSummary(appUser.id);
const weeklyDigest = await getWeeklyDigestData(appUser.id);
const planLabel = sub?.plan ?? 'FREE';

const importantItems: { title: string; detail: string; href: string; cta: string }[] = [];
if (taskSummary.overdue > 0) {
  importantItems.push({
    title: `${taskSummary.overdue} overdue task${taskSummary.overdue === 1 ? '' : 's'}`,
    detail: 'Start with overdue items first to avoid season drift.',
    href: taskSummary.nextTask ? `/app/spaces/${taskSummary.nextTask.space_id}/timeline` : '/app',
    cta: 'Review timeline'
  });
}
if (taskSummary.dueToday > 0) {
  importantItems.push({
    title: `${taskSummary.dueToday} task${taskSummary.dueToday === 1 ? '' : 's'} due today`,
    detail: 'Quick wins today keep your plan on track.',
    href: taskSummary.nextTask ? `/app/spaces/${taskSummary.nextTask.space_id}/timeline` : '/app',
    cta: 'Do today'
  });
}
if (!flags.reminders) {
  importantItems.push({
    title: 'Reminders are off',
    detail: 'Upgrade to Plus/Ultra for automatic email reminders.',
    href: '/app/settings',
    cta: 'Upgrade plan'
  });
}
if (spaces.length === 0) {
  importantItems.push({
    title: 'No spaces configured',
    detail: 'Create your first space to unlock planning, timeline, and blueprint.',
    href: '/app/spaces/new',
    cta: 'Create space'
  });
}
---

<BaseLayout title="Dashboard | Garden OS">
  <AppShell title="Dashboard">
    {doneTaskId && doneSpaceId && doneAt && (
      <section id="undo-toast" class="card border-emerald-200 bg-emerald-50/70">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-sm text-emerald-900">Task marked complete. Undo available for <span id="undo-seconds">10</span>s.</p>
          <form method="POST" id="undo-form" class="m-0">
            <input type="hidden" name="action" value="digest-undo" />
            <input type="hidden" name="taskId" value={doneTaskId} />
            <input type="hidden" name="spaceId" value={doneSpaceId} />
            <button id="undo-btn" class="btn-outline rounded-md px-3 py-1.5 text-xs" type="submit">Undo</button>
          </form>
        </div>
      </section>
    )}

    <section class="card space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-moss-600">Focus now</p>
          <h2 class="mt-1 font-serif text-3xl text-moss-800">
            {taskSummary.overdue > 0
              ? 'Clear overdue tasks first'
              : taskSummary.dueToday > 0
                ? `You have ${taskSummary.dueToday} task${taskSummary.dueToday === 1 ? '' : 's'} today`
                : 'Your garden is in a good place this week'}
          </h2>
          {taskSummary.nextTask && (
            <p class="mt-1 text-sm text-moss-700">
              Next task: <span class="font-medium">{taskSummary.nextTask.title}</span> in {taskSummary.nextTask.space_name} on {taskSummary.nextTask.due_date}
            </p>
          )}
        </div>
        <a href="/app/spaces/new" class="btn-primary rounded-md px-3 py-2 text-sm">New Space</a>
      </div>

      <div class="grid gap-3 md:grid-cols-4">
        <div class="rounded-lg border border-moss-100 px-3 py-3">
          <p class="text-xs uppercase tracking-wide text-moss-600">Spaces</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{spaces.length}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-3">
          <p class="text-xs uppercase tracking-wide text-moss-600">Plan</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{planLabel}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-3">
          <p class="text-xs uppercase tracking-wide text-moss-600">Due today</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{taskSummary.dueToday}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-3">
          <p class="text-xs uppercase tracking-wide text-moss-600">Due this week</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{taskSummary.dueThisWeek}</p>
        </div>
      </div>
    </section>

    <section class="card space-y-3">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-moss-600">Weekly Digest</p>
          <h2 class="mt-1 font-serif text-2xl text-moss-800">Top actions for the next 7 days</h2>
        </div>
        <button id="digest-ai-btn" class="btn-outline rounded-md px-3 py-2 text-xs">Enhance with AI</button>
      </div>

      <div class="grid gap-2 md:grid-cols-3">
        <div class="rounded-md border border-moss-100 px-3 py-2">
          <p class="text-xs text-moss-600">Overdue</p>
          <p class="text-lg font-semibold text-red-700">{weeklyDigest.counts.overdue}</p>
        </div>
        <div class="rounded-md border border-moss-100 px-3 py-2">
          <p class="text-xs text-moss-600">Due today</p>
          <p class="text-lg font-semibold text-moss-800">{weeklyDigest.counts.dueToday}</p>
        </div>
        <div class="rounded-md border border-moss-100 px-3 py-2">
          <p class="text-xs text-moss-600">Due this week</p>
          <p class="text-lg font-semibold text-moss-800">{weeklyDigest.counts.dueWeek}</p>
        </div>
      </div>

      <pre id="weekly-digest-text" class="whitespace-pre-wrap rounded-md border border-moss-100 bg-[var(--surface-strong)] px-3 py-3 text-sm text-moss-800">{weeklyDigest.digestText}</pre>
      <p id="weekly-digest-source" class="text-xs text-moss-600">Source: rules</p>

      {weeklyDigest.actions.length > 0 && (
        <div class="space-y-2">
          {weeklyDigest.actions.map((action, idx) => (
            <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-moss-100 px-3 py-2">
              <div>
                <p class="text-sm font-medium text-moss-800">{idx + 1}. {action.title}</p>
                <p class="text-xs text-moss-600">{action.space_name} · due {action.due_date}</p>
              </div>
              <div class="flex gap-2">
                <form method="POST">
                  <input type="hidden" name="action" value="digest-complete" />
                  <input type="hidden" name="taskId" value={action.task_id} />
                  <input type="hidden" name="spaceId" value={action.space_id} />
                  <button class="btn-outline rounded-md px-2.5 py-1.5 text-xs" type="submit">Complete</button>
                </form>
                <a class="btn-outline rounded-md px-2.5 py-1.5 text-xs" href={`/app/spaces/${action.space_id}/timeline`}>Open timeline</a>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    {importantItems.length > 0 && (
      <section class="card space-y-3">
        <h2 class="font-serif text-2xl text-moss-800">Important Right Now</h2>
        <div class="grid gap-2">
          {importantItems.map((item) => (
            <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-moss-100 px-3 py-2">
              <div>
                <p class="text-sm font-medium text-moss-800">{item.title}</p>
                <p class="text-xs text-moss-600">{item.detail}</p>
              </div>
              <a href={item.href} class="btn-outline rounded-md px-3 py-1.5 text-xs">{item.cta}</a>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="card space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-serif text-2xl">Your Spaces</h2>
        <a href="/app/spaces/new" class="btn-primary rounded-md px-3 py-2 text-sm">New Space</a>
      </div>
      {spaces.length === 0 ? (
        <p class="text-sm text-moss-700">Start your first custom space to generate a plan and timeline.</p>
      ) : (
        <ul class="space-y-3">
          {spaces.map((space) => (
            <li class="rounded-lg border border-moss-100 px-4 py-3">
              <div>
                <p class="font-medium">{space.name}</p>
                <p class="text-xs text-moss-600">ZIP {space.zip} · {space.total_sqft} sqft · {space.access_role}</p>
              </div>
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <a class="btn-outline rounded-md px-2.5 py-1.5" href={`/app/spaces/${space.id}`}>Overview</a>
                <a class="btn-outline rounded-md px-2.5 py-1.5" href={`/app/spaces/${space.id}/planner`}>Planner</a>
                <a class="btn-outline rounded-md px-2.5 py-1.5" href={`/app/spaces/${space.id}/timeline`}>Timeline</a>
                <a class="btn-outline rounded-md px-2.5 py-1.5" href={`/app/spaces/${space.id}/blueprint`}>Blueprint</a>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <script is:inline>
      (() => {
        const btn = document.getElementById('digest-ai-btn');
        const text = document.getElementById('weekly-digest-text');
        const source = document.getElementById('weekly-digest-source');
        if (!(btn instanceof HTMLButtonElement) || !(text instanceof HTMLElement) || !(source instanceof HTMLElement)) return;

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          btn.textContent = 'Enhancing...';
          try {
            const res = await fetch('/api/ai/weekly-digest');
            if (!res.ok) throw new Error('failed');
            const data = await res.json();
            text.textContent = data.text || text.textContent || '';
            source.textContent = `Source: ${data.source === 'ai' ? 'AI' : 'rules fallback'}`;
          } catch {
            source.textContent = 'Source: rules fallback (AI unavailable)';
          } finally {
            btn.disabled = false;
            btn.textContent = 'Enhance with AI';
          }
        });
      })();
    </script>

    {doneTaskId && doneSpaceId && doneAt && (
      <script is:inline define:vars={{ doneAt }}>
        (() => {
          const toast = document.getElementById('undo-toast');
          const secondsEl = document.getElementById('undo-seconds');
          const undoBtn = document.getElementById('undo-btn');
          const startedAt = Number(doneAt);
          if (!(toast instanceof HTMLElement) || !(secondsEl instanceof HTMLElement) || !(undoBtn instanceof HTMLButtonElement) || Number.isNaN(startedAt)) {
            return;
          }

          const tick = () => {
            const elapsed = Math.floor((Date.now() - startedAt) / 1000);
            const remaining = Math.max(0, 10 - elapsed);
            secondsEl.textContent = String(remaining);
            if (remaining <= 0) {
              undoBtn.disabled = true;
              undoBtn.textContent = 'Undo expired';
              setTimeout(() => {
                toast.style.display = 'none';
              }, 600);
              return;
            }
            setTimeout(tick, 250);
          };
          tick();
        })();
      </script>
    )}
  </AppShell>
</BaseLayout>
