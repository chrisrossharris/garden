---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Garden OS | Plan your custom space">
  <section class="hero-surface grid gap-8 rounded-2xl p-8 md:grid-cols-2">
    <div class="space-y-5">
      <p class="hero-pill inline-flex rounded-full px-3 py-1 text-xs uppercase tracking-wide">Custom-space garden planning</p>
      <h1 class="font-serif text-5xl leading-tight text-moss-800">Design a calm, practical garden plan for your exact property.</h1>
      <p class="text-moss-700">Garden OS combines your ZIP-specific season data, area-level space planning, and task reminders into one weekly workflow.</p>
      <div class="flex gap-3">
        <a href="/app" class="btn-primary rounded-lg px-4 py-2">Open App</a>
        <a href="/pricing" class="btn-outline rounded-lg px-4 py-2">See Pricing</a>
      </div>
    </div>
    <div class="card space-y-3">
      <h2 class="font-serif text-2xl text-moss-800">What you get</h2>
      <ul class="space-y-2 text-sm text-moss-700">
        <li>Area-by-area capacity planning</li>
        <li>ZIP-based frost + hardiness profile</li>
        <li>One-time Blueprint PDF and permanent download</li>
        <li>Tiered reminders + weekly focus dashboard</li>
      </ul>
    </div>
  </section>
</BaseLayout>
