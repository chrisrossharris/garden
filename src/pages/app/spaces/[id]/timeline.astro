---
import dayjs from 'dayjs';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import { requireAppUser } from '@/lib/auth';
import { getSpace } from '@/lib/services/spaces';
import { getWeeklyForecast } from '@/lib/services/weather';
import { getLocationProfile } from '@/lib/services/location';
import {
  autoPlanNext14Days,
  completeDueToday,
  completeTask,
  listTimelineTasks,
  regenerateTasksForSpace,
  snoozeOverdue,
  snoozeTask
} from '@/lib/services/tasks';

const appUser = await requireAppUser(Astro.locals);
if (!appUser) return Astro.redirect('/');

const id = Astro.params.id as string;
const space = await getSpace(id, appUser.id);
if (!space) return Astro.redirect('/app');
const profile = await getLocationProfile(space.zip);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action'));
  const taskId = String(form.get('taskId') ?? '');

  if (action === 'refresh') {
    await regenerateTasksForSpace(id);
  }
  if (action === 'complete' && taskId) {
    await completeTask(taskId, id);
  }
  if (action === 'snooze' && taskId) {
    await snoozeTask(taskId, id, 3);
  }
  if (action === 'snooze-custom' && taskId) {
    const days = Math.max(1, Number(form.get('days') ?? 1));
    await snoozeTask(taskId, id, days);
  }
  if (action === 'complete-today') {
    await completeDueToday(id);
  }
  if (action === 'snooze-overdue') {
    await snoozeOverdue(id, 2);
  }
  if (action === 'autoplan-14') {
    await autoPlanNext14Days(id);
  }

  return Astro.redirect(`/app/spaces/${id}/timeline`);
}

const tasks = await listTimelineTasks(id);
const forecast = await getWeeklyForecast(space.zip);
const today = dayjs().startOf('day');

const overdue = tasks.filter((t) => t.status !== 'done' && dayjs(t.due_date).isBefore(today, 'day'));
const dueToday = tasks.filter((t) => t.status !== 'done' && dayjs(t.due_date).isSame(today, 'day'));
const thisWeek = tasks.filter((t) => {
  const due = dayjs(t.due_date);
  const diff = due.diff(today, 'day');
  return t.status !== 'done' && diff > 0 && diff <= 7;
});
const nextUp = tasks.filter((t) => {
  const diff = dayjs(t.due_date).diff(today, 'day');
  return t.status !== 'done' && diff > 7;
});
const done = tasks.filter((t) => t.status === 'done').slice(-8).reverse();

const totalOpen = overdue.length + dueToday.length + thisWeek.length + nextUp.length;
const completionPct = tasks.length === 0 ? 0 : Math.round((done.length / tasks.length) * 100);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric'
});
const formatDue = (iso: string) => dateFmt.format(new Date(`${iso}T00:00:00`));

const heavyRainDays = forecast.filter((d) => d.precipProb >= 60 || d.precipMm >= 10);
const frostDays = forecast.filter((d) => d.minF <= 36);
const heatDays = forecast.filter((d) => d.maxF >= 88);
const goodWorkWindows = forecast
  .filter((d) => d.precipProb < 35 && d.precipMm < 2 && d.maxF >= 52 && d.maxF <= 86)
  .slice(0, 3);

const weatherAlerts: { title: string; detail: string; tone: 'warning' | 'info' }[] = [];
if (frostDays.length > 0) {
  weatherAlerts.push({
    title: 'Frost watch',
    detail: `${frostDays.length} day(s) at or below 36F. Hold tender transplants and protect seedlings.`,
    tone: 'warning'
  });
}
if (heavyRainDays.length > 0) {
  weatherAlerts.push({
    title: 'Heavy rain risk',
    detail: `${heavyRainDays.length} wetter day(s). Move watering tasks earlier and avoid compacting wet soil.`,
    tone: 'warning'
  });
}
if (heatDays.length > 0) {
  weatherAlerts.push({
    title: 'Heat stress window',
    detail: `${heatDays.length} hot day(s) above 88F. Prioritize morning watering and mulch checks.`,
    tone: 'info'
  });
}
if (weatherAlerts.length === 0) {
  weatherAlerts.push({
    title: 'Stable week',
    detail: 'No major weather interruptions expected. Good time to execute outdoor planting tasks.',
    tone: 'info'
  });
}

const forecastByDate = new Map(forecast.map((d) => [d.date, d]));
const planningCandidates = [...overdue, ...dueToday, ...thisWeek].slice(0, 6);
const weatherAdjustments = planningCandidates.flatMap((task) => {
  const title = task.title.toLowerCase();
  const due = dayjs(task.due_date);
  const dueKey = due.format('YYYY-MM-DD');
  const dueForecast = forecastByDate.get(dueKey);
  if (!dueForecast) return [];

  const isPlanting = /(sow|seed|transplant|plant)/i.test(title);
  const isWater = /water/i.test(title);
  const isPrune = /prune/i.test(title);
  if (!isPlanting && !isWater && !isPrune) return [];

  const riskyForDue =
    (isPlanting && (dueForecast.minF <= 38 || dueForecast.precipProb >= 65)) ||
    (isWater && dueForecast.precipProb >= 70) ||
    (isPrune && dueForecast.precipProb >= 75);
  if (!riskyForDue) return [];

  const better = forecast.find((f) => {
    const candidate = dayjs(f.date);
    if (candidate.isBefore(due, 'day')) return false;
    const diff = candidate.diff(due, 'day');
    if (diff < 1 || diff > 5) return false;
    if (isPlanting) return f.minF > 40 && f.precipProb < 50;
    if (isWater) return f.precipProb < 45;
    if (isPrune) return f.precipProb < 55;
    return false;
  });
  if (!better) return [];

  const delayDays = dayjs(better.date).diff(due, 'day');
  return [
    {
      taskId: task.id,
      title: task.title,
      from: dueKey,
      to: better.date,
      delayDays,
      reason: isPlanting
        ? `Better planting window after weather risk (frost/rain) clears.`
        : isWater
          ? 'Rain likely on due date; delay manual watering.'
          : 'Drier window is better for pruning and disease prevention.'
    }
  ];
});
---

<BaseLayout title="Timeline | Garden OS">
  <AppShell title="Timeline">
    <section class="card space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-moss-600">Weekly Command Center</p>
          <h2 class="mt-1 font-serif text-3xl text-moss-800">
            {overdue.length > 0
              ? `${overdue.length} overdue task${overdue.length === 1 ? '' : 's'} need attention`
              : dueToday.length > 0
                ? `${dueToday.length} task${dueToday.length === 1 ? '' : 's'} due today`
                : totalOpen > 0
                  ? 'You are on track this week'
                  : 'No pending tasks yet'}
          </h2>
          <p class="mt-1 text-sm text-moss-700">Space: {space.name}</p>
        </div>
        <form method="POST">
          <input type="hidden" name="action" value="refresh" />
          <button class="btn-outline rounded-md px-3 py-2 text-sm" type="submit">Recalculate from frost profile</button>
        </form>
      </div>

      <div class="grid gap-3 md:grid-cols-5">
        <div class="rounded-lg border border-moss-100 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">Overdue</p>
          <p class="mt-1 text-2xl font-semibold text-red-700">{overdue.length}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">Due Today</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{dueToday.length}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">This Week</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{thisWeek.length}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">Next Up</p>
          <p class="mt-1 text-2xl font-semibold text-moss-800">{nextUp.length}</p>
        </div>
        <div class="rounded-lg border border-moss-100 px-3 py-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">Recent Done</p>
          <p class="mt-1 text-2xl font-semibold text-emerald-700">{completionPct}%</p>
        </div>
      </div>

      <div class="grid gap-3 rounded-lg border border-moss-100 p-3 md:grid-cols-3">
        <div class="md:col-span-2 space-y-2">
          <p class="text-xs uppercase tracking-wide text-moss-600">Weather-Aware Priorities · ZIP {space.zip} · Zone {profile.zone}</p>
          {weatherAlerts.map((alert) => (
            <div class={`rounded-md border px-3 py-2 text-sm ${
              alert.tone === 'warning'
                ? 'border-amber-200 bg-amber-50 text-amber-900'
                : 'border-moss-100 bg-[var(--surface-strong)] text-moss-800'
            }`}>
              <p class="font-medium">{alert.title}</p>
              <p class="mt-0.5 text-xs">{alert.detail}</p>
            </div>
          ))}
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-moss-600">7-Day Snapshot</p>
          <ul class="mt-2 space-y-1.5 text-xs text-moss-700">
            {forecast.map((d) => (
              <li class="rounded-md border border-moss-100 px-2 py-1">
                <p class="font-medium">{formatDue(d.date)}</p>
                <p>{d.summary} · {d.maxF}/{d.minF}F · {d.precipProb}% rain</p>
              </li>
            ))}
          </ul>
          <p class="mt-2 text-xs text-moss-600">
            Best outdoor windows:{' '}
            {goodWorkWindows.length > 0
              ? goodWorkWindows.map((d) => formatDue(d.date)).join(', ')
              : 'none this week'}
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <form method="POST">
          <input type="hidden" name="action" value="autoplan-14" />
          <button class="btn-primary rounded-md px-3 py-1.5 text-xs" type="submit">Auto-plan next 14 days</button>
        </form>
        <form method="POST">
          <input type="hidden" name="action" value="complete-today" />
          <button class="btn-primary rounded-md px-3 py-1.5 text-xs" type="submit" disabled={dueToday.length === 0}>Complete all due today</button>
        </form>
        <form method="POST">
          <input type="hidden" name="action" value="snooze-overdue" />
          <button class="btn-outline rounded-md px-3 py-1.5 text-xs" type="submit" disabled={overdue.length === 0}>Snooze overdue +2d</button>
        </form>
      </div>

      {weatherAdjustments.length > 0 && (
        <div class="space-y-2 rounded-lg border border-moss-100 p-3">
          <p class="text-xs uppercase tracking-wide text-moss-600">Weather-Based Task Adjustments</p>
          <ul class="space-y-2">
            {weatherAdjustments.map((adj) => (
              <li class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
                <p class="font-medium">{adj.title}</p>
                <p class="mt-0.5 text-xs">{adj.reason}</p>
                <p class="mt-0.5 text-xs">Move from {formatDue(adj.from)} to {formatDue(adj.to)} (+{adj.delayDays}d).</p>
                <form method="POST" class="mt-2">
                  <input type="hidden" name="action" value="snooze-custom" />
                  <input type="hidden" name="taskId" value={adj.taskId} />
                  <input type="hidden" name="days" value={adj.delayDays} />
                  <button class="btn-outline rounded-md px-2 py-1 text-xs" type="submit">Apply weather shift</button>
                </form>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <div class="grid gap-4 md:grid-cols-2">
      <section class="card">
        <h3 class="font-semibold text-moss-800">Overdue</h3>
        {overdue.length === 0 ? (
          <p class="mt-2 text-sm text-moss-700">No overdue tasks.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {overdue.map((t) => (
              <li class="rounded-md border border-red-200 bg-red-50 px-3 py-2">
                <p class="font-medium text-moss-800">{t.title}</p>
                <p class="text-xs text-moss-600">Due {formatDue(t.due_date)}</p>
                {t.instructions && <p class="mt-1 text-xs text-moss-700">{t.instructions}</p>}
                <div class="mt-2 flex gap-2">
                  <form method="POST"><input type="hidden" name="action" value="complete" /><input type="hidden" name="taskId" value={t.id} /><button class="btn-primary rounded-md px-2 py-1 text-xs">Complete</button></form>
                  <form method="POST"><input type="hidden" name="action" value="snooze" /><input type="hidden" name="taskId" value={t.id} /><button class="btn-outline rounded-md px-2 py-1 text-xs">Snooze 3d</button></form>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card">
        <h3 class="font-semibold text-moss-800">Due Today</h3>
        {dueToday.length === 0 ? (
          <p class="mt-2 text-sm text-moss-700">Nothing due today.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {dueToday.map((t) => (
              <li class="rounded-md border border-moss-100 px-3 py-2">
                <p class="font-medium text-moss-800">{t.title}</p>
                <p class="text-xs text-moss-600">Due {formatDue(t.due_date)}</p>
                {t.instructions && <p class="mt-1 text-xs text-moss-700">{t.instructions}</p>}
                <div class="mt-2 flex gap-2">
                  <form method="POST"><input type="hidden" name="action" value="complete" /><input type="hidden" name="taskId" value={t.id} /><button class="btn-primary rounded-md px-2 py-1 text-xs">Complete</button></form>
                  <form method="POST"><input type="hidden" name="action" value="snooze" /><input type="hidden" name="taskId" value={t.id} /><button class="btn-outline rounded-md px-2 py-1 text-xs">Snooze 3d</button></form>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card">
        <h3 class="font-semibold text-moss-800">This Week</h3>
        {thisWeek.length === 0 ? (
          <p class="mt-2 text-sm text-moss-700">No additional tasks this week.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {thisWeek.map((t) => (
              <li class="rounded-md border border-moss-100 px-3 py-2">
                <p class="font-medium text-moss-800">{t.title}</p>
                <p class="text-xs text-moss-600">Due {formatDue(t.due_date)}</p>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card">
        <h3 class="font-semibold text-moss-800">Next Up</h3>
        {nextUp.length === 0 ? (
          <p class="mt-2 text-sm text-moss-700">No future tasks yet.</p>
        ) : (
          <ul class="mt-3 space-y-2 text-sm">
            {nextUp.slice(0, 10).map((t) => (
              <li class="rounded-md border border-moss-100 px-3 py-2">
                <p class="font-medium text-moss-800">{t.title}</p>
                <p class="text-xs text-moss-600">Due {formatDue(t.due_date)}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>

    {done.length > 0 && (
      <section class="card">
        <h3 class="font-semibold text-moss-800">Recently Completed</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {done.map((t) => (
            <li class="rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2">
              {t.title} - {formatDue(t.due_date)}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="card space-y-3">
      <h3 class="font-semibold text-moss-800">Garden Coach (AI + Rule Fallback)</h3>
      <p class="text-xs text-moss-600">Ask for weekly priorities, indoor seed starts, direct sow timing, or companion suggestions.</p>
      <form id="coach-form" class="grid gap-2 md:grid-cols-[1fr_auto]">
        <input
          id="coach-question"
          class="rounded-md"
          type="text"
          placeholder="What should I focus on this week in this bed?"
          required
        />
        <button class="btn-outline rounded-md px-3 py-2 text-sm" type="submit">Ask Coach</button>
      </form>
      <div id="coach-answer" class="rounded-md border border-moss-100 bg-[var(--surface-strong)] p-3 text-sm text-moss-800">
        No question yet.
      </div>
    </section>

    <script is:inline define:vars={{ id }}>
      (() => {
        const form = document.getElementById('coach-form');
        const input = document.getElementById('coach-question');
        const answer = document.getElementById('coach-answer');
        if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !(answer instanceof HTMLElement)) return;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const question = input.value.trim();
          if (!question) return;
          answer.textContent = 'Thinking...';
          try {
            const res = await fetch('/api/ai/coach', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ spaceId: id, question })
            });
            if (!res.ok) throw new Error(await res.text());
            const data = await res.json();
            answer.textContent = data.answer || 'No answer.';
          } catch (err) {
            answer.textContent = 'Coach is unavailable right now. Try again.';
          }
        });
      })();
    </script>
  </AppShell>
</BaseLayout>
