---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import { requireAppUser } from '@/lib/auth';
import { getSpace, listAreas } from '@/lib/services/spaces';
import { one } from '@/lib/db/client';

const appUser = await requireAppUser(Astro.locals);
if (!appUser) return Astro.redirect('/');

const id = Astro.params.id as string;
const space = await getSpace(id, appUser.id);
if (!space) return Astro.redirect('/app');

const areas = await listAreas(id);
const purchase = await one<{ status: string; pdf_url: string | null }>(
  `SELECT status, pdf_url FROM purchases WHERE user_id = $1 AND garden_space_id = $2 ORDER BY created_at DESC LIMIT 1`,
  [appUser.id, id]
);
---

<BaseLayout title="Blueprint | Garden OS">
  <AppShell title="Blueprint Review">
    <section class="card space-y-4">
      <p class="text-sm text-moss-700">Step 3-4 of 5: Review plan, then purchase to unlock permanent PDF download.</p>
      <h2 class="font-semibold">{space.name} · ZIP {space.zip}</h2>
      <ul class="space-y-2 text-sm">
        {areas.map((a) => <li>{a.name} · {a.sqft} sqft · {a.sun_exposure}</li>)}
      </ul>
      <button
        class="rounded-md bg-moss-700 px-4 py-2 text-sm text-white"
        onclick={`fetch('/.netlify/functions/create-checkout-session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:'BLUEPRINT',userId:'${appUser.id}',gardenSpaceId:'${id}'})}).then(r=>r.json()).then(d=>window.location=d.url)`}
      >
        Purchase Blueprint
      </button>

      {purchase?.status === 'completed' && purchase?.pdf_url && (
        <a class="inline-flex rounded-md border border-moss-200 px-3 py-2 text-sm" href={purchase.pdf_url} target="_blank">Download Blueprint PDF</a>
      )}
    </section>
  </AppShell>
</BaseLayout>
